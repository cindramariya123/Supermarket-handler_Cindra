{
  "name": "Expiry Date Monitor",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "triggerAtHour": 8
            }
          ]
        }
      },
      "id": "a1000000-0000-4000-8000-000000000001",
      "name": "Every Morning 8 AM",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 0]
    },
    {
      "parameters": {
        "documentId": {
          "__rl": true,
          "mode": "url",
          "value": "PASTE_YOUR_GOOGLE_SHEET_URL_HERE"
        },
        "sheetName": {
          "__rl": true,
          "mode": "name",
          "value": "Products"
        },
        "options": {}
      },
      "id": "a1000000-0000-4000-8000-000000000002",
      "name": "Read Products",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [220, 0]
    },
    {
      "parameters": {
        "jsCode": "const today = new Date();\ntoday.setHours(0, 0, 0, 0);\n\nreturn $input.all().map(item => {\n  const expiry = new Date(item.json['Expiry Date']);\n  expiry.setHours(0, 0, 0, 0);\n  const daysLeft = Math.round((expiry - today) / 86400000);\n\n  let discount = 0;\n  let action = 'No action';\n\n  if (daysLeft < 0) {\n    action = 'EXPIRED - Remove from shelf';\n  } else if (daysLeft <= 1) {\n    discount = 30;\n    action = 'Apply 30% discount';\n  } else if (daysLeft <= 3) {\n    discount = 20;\n    action = 'Apply 20% discount';\n  }\n\n  return { json: { ...item.json, days_left: daysLeft, Discount: discount + '%', Action: action } };\n});"
      },
      "id": "a1000000-0000-4000-8000-000000000003",
      "name": "Calculate Discount",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [440, 0]
    },
    {
      "parameters": {
        "operation": "update",
        "documentId": {
          "__rl": true,
          "mode": "url",
          "value": "PASTE_YOUR_GOOGLE_SHEET_URL_HERE"
        },
        "sheetName": {
          "__rl": true,
          "mode": "name",
          "value": "Products"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "Product": "={{ $json.Product }}",
            "Discount": "={{ $json.Discount }}",
            "Action": "={{ $json.Action }}"
          },
          "matchingColumns": ["Product"],
          "schema": [
            { "id": "Product", "displayName": "Product", "required": false, "defaultMatch": false, "display": true, "type": "string", "canBeUsedToMatch": true },
            { "id": "Discount", "displayName": "Discount", "required": false, "defaultMatch": false, "display": true, "type": "string", "canBeUsedToMatch": true },
            { "id": "Action", "displayName": "Action", "required": false, "defaultMatch": false, "display": true, "type": "string", "canBeUsedToMatch": true }
          ]
        },
        "options": {}
      },
      "id": "a1000000-0000-4000-8000-000000000004",
      "name": "Update Sheet",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [660, -120]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "b2000000-0000-4000-8000-000000000001",
              "leftValue": "={{ $json.days_left }}",
              "rightValue": 3,
              "operator": {
                "type": "number",
                "operation": "lte"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "a1000000-0000-4000-8000-000000000005",
      "name": "Expiring Within 3 Days",
      "type": "n8n-nodes-base.filter",
      "typeVersion": 2,
      "position": [660, 120]
    },
    {
      "parameters": {
        "jsCode": "const rows = $input.all().map(i => i.json);\n\nconst lines = rows.map(r =>\n  `- ${r.Product} (${r.Quantity} units) - ${r.days_left < 0 ? 'expired' : r.days_left + ' day(s) left'} - ${r.Action}`\n).join('\\n');\n\nreturn [{\n  json: {\n    subject: `Expiry Alert: ${rows.length} products need attention today`,\n    body: `Good morning,\\n\\nThese products need attention today:\\n\\n${lines}\\n\\nRegards,\\nExpiry Monitor`\n  }\n}];"
      },
      "id": "a1000000-0000-4000-8000-000000000006",
      "name": "Build Email",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [880, 120]
    },
    {
      "parameters": {
        "sendTo": "manager@example.com",
        "subject": "={{ $json.subject }}",
        "emailType": "text",
        "message": "={{ $json.body }}",
        "options": {}
      },
      "id": "a1000000-0000-4000-8000-000000000007",
      "name": "Email Manager",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [1100, 120]
    }
  ],
  "connections": {
    "Every Morning 8 AM": {
      "main": [[{ "node": "Read Products", "type": "main", "index": 0 }]]
    },
    "Read Products": {
      "main": [[{ "node": "Calculate Discount", "type": "main", "index": 0 }]]
    },
    "Calculate Discount": {
      "main": [[
        { "node": "Update Sheet", "type": "main", "index": 0 },
        { "node": "Expiring Within 3 Days", "type": "main", "index": 0 }
      ]]
    },
    "Expiring Within 3 Days": {
      "main": [[{ "node": "Build Email", "type": "main", "index": 0 }]]
    },
    "Build Email": {
      "main": [[{ "node": "Email Manager", "type": "main", "index": 0 }]]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
